# 茶与金平糖 —— nginx 反向代理示例（无 Docker，直接反代 Go 单二进制）
#
# 关键点：
#   1. WebSocket 必须带 Upgrade/Connection 头，且 proxy_read_timeout 要够长；
#   2. 前端已 embed 进二进制，nginx 不需要站点根目录；
#   3. 可选：给带 hash 的静态资源加长缓存（Go 已经返回 Cache-Control，nginx 只做代理即可）。

upstream tea_musicd {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    server_name music.tea-kompeito.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name music.tea-kompeito.com;

    ssl_certificate     /etc/letsencrypt/live/music.tea-kompeito.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/music.tea-kompeito.com/privkey.pem;

    # 音频/封面来自网易云 CDN，与本站无关；这里只反代 API + 页面 + WS
    client_max_body_size 4m;

    location /api/ws {
        proxy_pass http://tea_musicd;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 音乐房是长连接，读超时要远大于心跳间隔
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass http://tea_musicd;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
